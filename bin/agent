#!/usr/bin/env python3
"""
agent: Source-First Task Execution Engine
Executes in-line TODO/FIXME tasks or task description files directly in the codebase.
Anchors all tasks and intent directly into source code as the single source of truth,
preventing task loss from session interruptions and computer crashes.

Powered by OpenCode subagents with automatic agy failover.
Dual CLI & Neovim workflow.
"""

import sys
import os
import re
import json
import glob
import time
import shutil
import difflib
import argparse
import subprocess
from pathlib import Path
from typing import List, Dict, Tuple, Optional, Any

# Terminal styling
RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
CYAN = "\033[36m"
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"

COMMENT_PREFIXES = {
    ".py": "#",
    ".sh": "#",
    ".bash": "#",
    ".yaml": "#",
    ".yml": "#",
    ".toml": "#",
    ".rs": "//",
    ".c": "//",
    ".cpp": "//",
    ".h": "//",
    ".hpp": "//",
    ".js": "//",
    ".ts": "//",
    ".go": "//",
    ".zig": "//",
    ".java": "//",
    ".lean": "--",
    ".lua": "--",
    ".sql": "--",
    ".hs": "--",
}

STRUCTURED_TODO_RE = re.compile(
    r'^[ \t]*(?:#|//|--)\s*(TODO|FIXME)\(([a-zA-Z0-9_\-]+)\s*\|\s*tier:([ABC])'
    r'((?:\s*\|\s*(?:blocks|depends_on):\[[a-zA-Z0-9_\-,\s]*\])*)\):(?:\s*(.*))?$'
)
UNSTRUCTURED_TODO_RE = re.compile(
    r'^[ \t]*(?:#|//|--)\s*(TODO|FIXME)(?:\(([^)]+)\))?\s*[:\-]?\s*(.*)$',
    re.IGNORECASE
)

SPINNER_FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]


def find_git_root(start_dir: Optional[Path] = None) -> Path:
    cur = (start_dir or Path.cwd()).resolve()
    while cur != cur.parent:
        if (cur / ".git").exists() or (cur / "Cargo.toml").exists() or (cur / "Makefile").exists():
            return cur
        cur = cur.parent
    return (start_dir or Path.cwd()).resolve()


def find_lgcc_bin() -> Optional[str]:
    script_dir = Path(__file__).resolve().parent
    candidates = [
        script_dir / "lgcc",
        Path.home() / ".local" / "bin" / "lgcc",
        Path.home() / ".config" / "nvim" / "bin" / "lgcc",
        Path.home() / "code" / "syn-nvim" / "bin" / "lgcc",
    ]
    for c in candidates:
        if c.is_file() and os.access(c, os.X_OK):
            return str(c)
    which = shutil.which("lgcc")
    if which:
        return which
    return None


def get_active_nvim_socket() -> Optional[str]:
    runtime_dir = f"/run/user/{os.getuid()}"
    if not os.path.exists(runtime_dir):
        return None
    for entry in sorted(os.listdir(runtime_dir), reverse=True):
        if entry.startswith("nvim.") and entry.endswith(".0"):
            sock_path = os.path.join(runtime_dir, entry)
            return sock_path
    return None


def extract_tasks_from_file(file_path: Path) -> List[Dict[str, Any]]:
    if not file_path.is_file():
        return []
    try:
        content = file_path.read_text(encoding="utf-8", errors="ignore")
    except Exception:
        return []

    lines = content.splitlines()
    tasks = []
    i = 0
    total = len(lines)

    while i < total:
        line = lines[i]
        sm = STRUCTURED_TODO_RE.match(line)
        um = UNSTRUCTURED_TODO_RE.match(line)

        if sm:
            kind, task_id, tier, attrs, desc = sm.groups()
            desc = desc.strip() if desc else ""
            task_lines_count = 1
            # Check for continuation lines (Description, Criterion, etc.)
            j = i + 1
            extra_desc = []
            while j < total:
                cont_line = lines[j].strip()
                if cont_line.startswith(("#", "//", "--")):
                    cleaned = re.sub(r'^(?:#|//|--)\s*', '', cont_line)
                    if cleaned.lower().startswith("description:"):
                        extra_desc.append(cleaned[12:].strip())
                        task_lines_count += 1
                        j += 1
                    elif cleaned.lower().startswith("criterion:"):
                        extra_desc.append(cleaned)
                        task_lines_count += 1
                        j += 1
                    elif cleaned.startswith("- ") or cleaned.startswith("* "):
                        extra_desc.append(cleaned)
                        task_lines_count += 1
                        j += 1
                    else:
                        break
                else:
                    break
            if extra_desc:
                full_desc = (desc + " " + " ".join(extra_desc)).strip()
            else:
                full_desc = desc

            tasks.append({
                "file": str(file_path),
                "line": i + 1,
                "lines_count": task_lines_count,
                "kind": kind.upper(),
                "id": task_id,
                "tier": tier.upper(),
                "description": full_desc or f"Task {task_id}",
                "raw_header": line.strip(),
            })
            i += task_lines_count
        elif um and not line.strip().startswith("#!"):
            kind, tag, desc = um.groups()
            desc = desc.strip() if desc else ""
            tasks.append({
                "file": str(file_path),
                "line": i + 1,
                "lines_count": 1,
                "kind": kind.upper(),
                "id": tag or f"todo-L{i+1}",
                "tier": "U",
                "description": desc or f"TODO at line {i+1}",
                "raw_header": line.strip(),
            })
            i += 1
        else:
            i += 1

    return tasks


def scan_project_tasks(root_dir: Path) -> List[Dict[str, Any]]:
    ignore_dirs = {".git", "vendor", "target", "build", ".lake", "__pycache__", ".venv", "venv", "node_modules", "logs"}
    scan_exts = {".py", ".rs", ".lean", ".sh", ".c", ".cpp", ".h", ".hpp", ".js", ".ts", ".go", ".lua"}

    all_tasks = []
    for dirpath, dirnames, filenames in os.walk(root_dir):
        dirnames[:] = [d for d in dirnames if d not in ignore_dirs and not d.startswith(".")]
        for fname in filenames:
            ext = os.path.splitext(fname)[1]
            if ext in scan_exts:
                fpath = Path(dirpath) / fname
                tasks = extract_tasks_from_file(fpath)
                all_tasks.extend(tasks)

    # Sort: Tier A > Tier B > Tier C > Unstructured U
    tier_weight = {"A": 1, "B": 2, "C": 3, "U": 4}
    all_tasks.sort(key=lambda t: (tier_weight.get(t["tier"], 5), t["file"], t["line"]))
    return all_tasks


def run_llm_task(prompt: str, engine: str = "opencode", model: Optional[str] = None) -> Tuple[Optional[str], str]:
    """Runs prompt against opencode or agy with streaming progress spinner."""
    opencode_bin = shutil.which("opencode") or str(Path.home() / ".opencode" / "bin" / "opencode")
    agy_bin = shutil.which("agy") or str(Path.home() / ".local" / "bin" / "agy")

    use_opencode = (engine == "opencode" or (engine == "auto" and os.path.exists(opencode_bin)))

    if use_opencode and os.path.exists(opencode_bin):
        cmd = [opencode_bin, "run", "--format", "json", "--auto", prompt]
        engine_label = "opencode"
    elif os.path.exists(agy_bin):
        agy_model = model or "gemini-3.8-flash-low"
        cmd = [agy_bin, "-p", prompt, "--model", agy_model, "--dangerously-skip-permissions", "--disable-slash-commands", "--effort", "low", "--output-format", "json"]
        engine_label = f"agy:{agy_model}"
    else:
        return None, "Neither 'opencode' nor 'agy' found in PATH."

    sys.stderr.write(f"\n{BOLD}{CYAN}● [Agent:{engine_label}]{RESET} Executing task...\n")
    sys.stderr.flush()

    frame_idx = 0
    t0 = time.time()
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    except Exception as e:
        return None, f"Failed to start {engine_label}: {e}"

    import threading
    stdout_lines = []
    stderr_lines = []

    def read_stream(stream, target_list):
        for line in iter(stream.readline, ''):
            target_list.append(line)
        stream.close()

    t_out = threading.Thread(target=read_stream, args=(proc.stdout, stdout_lines), daemon=True)
    t_err = threading.Thread(target=read_stream, args=(proc.stderr, stderr_lines), daemon=True)
    t_out.start()
    t_err.start()

    # Stream ticker while waiting
    while proc.poll() is None:
        elapsed = time.time() - t0
        spin = SPINNER_FRAMES[frame_idx % len(SPINNER_FRAMES)]
        sys.stderr.write(f"\r{BOLD}{BLUE}{spin}{RESET} [{engine_label}] generating implementation... ({elapsed:.1f}s)")
        sys.stderr.flush()
        frame_idx += 1
        time.sleep(0.08)

    t_out.join(timeout=2)
    t_err.join(timeout=2)
    sys.stderr.write("\r" + " " * 70 + "\r")
    sys.stderr.flush()

    stdout = "".join(stdout_lines)
    if proc.returncode != 0 and engine_label == "opencode" and os.path.exists(agy_bin):
        sys.stderr.write(f"{YELLOW}Warning: opencode failed (code {proc.returncode}), falling back to agy...{RESET}\n")
        return run_llm_task(prompt, engine="agy", model=model)

    # Parse output: opencode JSON stream or agy response
    full_text = ""
    for line in stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
            if isinstance(obj, dict):
                if obj.get("type") == "text" and "part" in obj and "text" in obj["part"]:
                    full_text += obj["part"]["text"]
                elif "response" in obj and isinstance(obj["response"], str):
                    full_text += obj["response"]
        except Exception:
            full_text += line + "\n"

    if not full_text:
        full_text = stdout

    return full_text, ""


def parse_solution_json(raw_response: str) -> Optional[Dict[str, Any]]:
    # 1. Direct JSON parse
    try:
        data = json.loads(raw_response.strip())
        if isinstance(data, dict) and ("content" in data or "code" in data):
            return data
    except Exception:
        pass

    # 2. Extract balanced JSON object by delimiter depth
    start = raw_response.find('{')
    while start != -1:
        depth = 0
        in_string = False
        escape = False
        for i in range(start, len(raw_response)):
            c = raw_response[i]
            if escape:
                escape = False
                continue
            if c == '\\':
                escape = True
                continue
            if c == '"':
                in_string = not in_string
                continue
            if not in_string:
                if c == '{':
                    depth += 1
                elif c == '}':
                    depth -= 1
                    if depth == 0:
                        candidate = raw_response[start:i+1]
                        try:
                            obj = json.loads(candidate)
                            if isinstance(obj, dict) and ("content" in obj or "code" in obj):
                                return obj
                        except Exception:
                            pass
                        break
        start = raw_response.find('{', start + 1)

    # 3. Extract code fences if present
    code_match = re.search(r'```(?:[a-zA-Z0-9_\-]+)?\n(.*?)\n```', raw_response, re.DOTALL)
    if code_match:
        return {
            "content": code_match.group(1),
            "description": "Code implementation from agent response",
        }

    return None


def execute_task(task: Dict[str, Any], file_path: Path, args: argparse.Namespace) -> int:
    root = find_git_root(file_path.parent)
    try:
        file_lines = file_path.read_text(encoding="utf-8", errors="ignore").splitlines()
    except Exception as e:
        sys.stderr.write(f"{RED}Error reading target file {file_path}: {e}{RESET}\n")
        return 1

    target_line = task["line"]
    lines_count = task.get("lines_count", 1)
    task_desc = task["description"]
    task_id = task.get("id", "task")
    tier = task.get("tier", "U")

    # Gather Code Graph IR via lgcc if available
    ir_context = ""
    lgcc_bin = find_lgcc_bin()
    if lgcc_bin and not args.dry_run:
        try:
            res = subprocess.run([lgcc_bin, "--route", str(file_path), "--budget", str(args.budget), "--format", "ir"],
                                 capture_output=True, text=True, timeout=10)
            if res.returncode == 0 and res.stdout.strip():
                ir_context = f"\nROUTED CODE GRAPH CONTEXT & SYMBOL CONTRACTS:\n{res.stdout}\n"
        except Exception:
            pass

    # Numbered source context
    numbered_source = []
    for idx, l in enumerate(file_lines):
        numbered_source.append(f"{idx+1}: {l}")
    source_context = "\n".join(numbered_source)

    prompt = f"""CRITICAL INSTRUCTION: You are the Autonomous Source-First Code Agent.
Your task is to implement the following in-line task directly inside the target file.
Source code is the single source of truth.

TARGET FILE: {file_path.relative_to(root) if file_path.is_relative_to(root) else file_path}
TASK: {task.get('raw_header', task_desc)}
DESCRIPTION: {task_desc}
TARGET LINE: {target_line} (replaces lines {target_line} to {target_line + lines_count - 1})

SURROUNDING SOURCE CODE (with 1-based line numbers):
{source_context}
{ir_context}
RULES:
1. Provide the complete, working, production-quality implementation to replace the TODO comment.
2. Maintain existing indentation, variable names, type signatures, and import patterns.
3. Do NOT include placeholder comments or ellipsis; write fully verified implementation.
4. Output STRICT JSON ONLY matching this schema:
{{
  "start_line": {target_line},
  "old_lines_count": {lines_count},
  "content": "<exact replacement code lines without line number prefixes>",
  "description": "<one-line summary of what was implemented>"
}}
Emit ONLY raw JSON. No markdown code blocks, no prose before or after.
"""

    if args.dry_run:
        print(f"{BOLD}{CYAN}=== DRY RUN PROMPT ==={RESET}")
        print(prompt)
        return 0

    response_text, err = run_llm_task(prompt, engine=args.engine, model=args.model)
    if err or not response_text:
        sys.stderr.write(f"{RED}Error: {err or 'Empty response from model'}{RESET}\n")
        return 1

    solution = parse_solution_json(response_text)
    if not solution or "content" not in solution:
        sys.stderr.write(f"{RED}Error: Failed to parse valid solution from model response.{RESET}\n")
        sys.stderr.write(f"Raw output:\n{response_text[:400]}...\n")
        return 1

    new_content = solution["content"]
    start_line = solution.get("start_line", target_line)
    old_count = solution.get("old_lines_count", lines_count)
    desc = solution.get("description", task_desc)

    new_lines = new_content.splitlines()

    # Calculate unified diff
    orig_slice = file_lines[max(0, start_line - 1): min(len(file_lines), start_line - 1 + old_count)]
    diff_lines = list(difflib.unified_diff(
        orig_slice,
        new_lines,
        fromfile=f"a/{file_path.name}:{start_line}",
        tofile=f"b/{file_path.name}:{start_line}",
        lineterm=""
    ))

    # Display clean colorized diff
    print(f"\n{BOLD}{CYAN}┌── Proposed Implementation for {task_id} ({tier}) ────────────────────┐{RESET}")
    print(f"{DIM}Target: {file_path}:{start_line} — {desc}{RESET}")
    print(f"{DIM}───────────────────────────────────────────────────────────────────{RESET}")

    for line in diff_lines:
        if line.startswith("+") and not line.startswith("+++"):
            print(f"{GREEN}{line}{RESET}")
        elif line.startswith("-") and not line.startswith("---"):
            print(f"{RED}{line}{RESET}")
        elif line.startswith("@"):
            print(f"{CYAN}{line}{RESET}")
        else:
            print(f"{DIM}{line}{RESET}")

    print(f"{BOLD}{CYAN}└───────────────────────────────────────────────────────────────────┘{RESET}\n")

    if args.diff:
        return 0

    # Apply or Interactive
    if args.interactive:
        return launch_nvim_interactive(file_path, start_line, new_content, old_count)

    if args.apply:
        meta = apply_changes(file_path, file_lines, start_line, old_count, new_lines, root, task_id, desc)
        print(f"{BOLD}{GREEN}✓ Applied implementation to {file_path}:{start_line}{RESET}")
        print(f"{BOLD}{YELLOW}● [Git Review] Recorded as UNREVIEWED (ID: {meta['id']}){RESET}")
        print(f"{DIM}  Review anytime with ':GitReview' in Neovim or 'agent review' in CLI.{RESET}")
        return 0

    # Prompt user
    try:
        choice = input(f"{BOLD}Apply these changes to {file_path.name}? [y/N/i(nteractive)] {RESET}").strip().lower()
    except (KeyboardInterrupt, EOFError):
        print(f"\n{YELLOW}Cancelled.{RESET}")
        return 0

    if choice == "y" or choice == "yes":
        meta = apply_changes(file_path, file_lines, start_line, old_count, new_lines, root, task_id, desc)
        print(f"{BOLD}{GREEN}✓ Successfully applied changes to {file_path}:{start_line}{RESET}")
        print(f"{BOLD}{YELLOW}● [Git Review] Recorded as UNREVIEWED (ID: {meta['id']}){RESET}")
        print(f"{DIM}  Review anytime with ':GitReview' in Neovim or 'agent review' in CLI.{RESET}")
        return 0
    elif choice == "i" or choice == "interactive":
        return launch_nvim_interactive(file_path, start_line, new_content, old_count)
    else:
        print(f"{YELLOW}Changes not applied.{RESET}")
        return 0


def get_reviews_dir(root: Path) -> Path:
    rdir = root / ".agent" / "reviews"
    rdir.mkdir(parents=True, exist_ok=True)
    gi = root / ".gitignore"
    if gi.exists():
        try:
            txt = gi.read_text(encoding="utf-8", errors="ignore")
            if ".agent/" not in txt and ".agent" not in txt:
                gi.write_text(txt.rstrip() + "\n.agent/\n", encoding="utf-8")
        except Exception:
            pass
    return rdir


def create_review_record(
    root: Path,
    file_path: Path,
    orig_lines: List[str],
    start_line: int,
    old_count: int,
    new_lines: List[str],
    task_id: str,
    description: str,
    status: str = "unreviewed"
) -> Dict[str, Any]:
    rdir = get_reviews_dir(root)
    timestamp = int(time.time())
    rev_id = f"rev-{timestamp}-{abs(hash(task_id + str(start_line))) % 10000:04d}"

    try:
        rel_file = file_path.relative_to(root)
    except ValueError:
        rel_file = file_path

    s_idx = max(0, start_line - 1)
    e_idx = min(len(orig_lines), s_idx + old_count)
    mod_lines = orig_lines[:s_idx] + new_lines + orig_lines[e_idx:]

    diff = list(difflib.unified_diff(
        [l + "\n" for l in orig_lines],
        [l + "\n" for l in mod_lines],
        fromfile=f"a/{rel_file}",
        tofile=f"b/{rel_file}"
    ))
    patch_str = "".join(diff)

    patch_file = rdir / f"{rev_id}.patch"
    patch_file.write_text(patch_str, encoding="utf-8")

    meta = {
        "id": rev_id,
        "task_id": task_id,
        "target_file": str(rel_file),
        "abs_file": str(file_path.resolve()),
        "start_line": start_line,
        "old_lines_count": old_count,
        "new_lines_count": len(new_lines),
        "old_lines": orig_lines[s_idx:e_idx],
        "new_lines": new_lines,
        "description": description,
        "created_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        "status": status,
        "patch_file": str(patch_file.relative_to(root)),
    }

    meta_file = rdir / f"{rev_id}.json"
    meta_file.write_text(json.dumps(meta, indent=2), encoding="utf-8")
    return meta


def get_review_records(root: Path, status_filter: Optional[str] = "unreviewed") -> List[Dict[str, Any]]:
    rdir = root / ".agent" / "reviews"
    if not rdir.exists():
        return []
    records = []
    for f in rdir.glob("*.json"):
        try:
            obj = json.loads(f.read_text(encoding="utf-8", errors="ignore"))
            if isinstance(obj, dict) and "id" in obj:
                if status_filter is None or obj.get("status") == status_filter:
                    records.append(obj)
        except Exception:
            pass
    records.sort(key=lambda r: r.get("created_at", ""), reverse=True)
    return records


def revert_review_record(root: Path, rev: Dict[str, Any]) -> bool:
    patch_path = root / rev.get("patch_file", "")
    target_rel = rev.get("target_file", "")
    target_file = root / target_rel

    # 1. Try git apply -R
    if patch_path.exists():
        res = subprocess.run(["git", "apply", "-R", str(patch_path)], cwd=root, capture_output=True, text=True)
        if res.returncode == 0:
            rev["status"] = "rejected"
            rev["reviewed_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
            meta_file = root / rev.get("patch_file", "").replace(".patch", ".json")
            if meta_file.exists():
                meta_file.write_text(json.dumps(rev, indent=2), encoding="utf-8")
            return True

    # 2. Line-replacement fallback
    if target_file.exists() and "old_lines" in rev:
        try:
            lines = target_file.read_text(encoding="utf-8", errors="ignore").splitlines()
            s_idx = max(0, rev.get("start_line", 1) - 1)
            new_cnt = rev.get("new_lines_count", len(rev.get("new_lines", [])))
            restored = lines[:s_idx] + rev["old_lines"] + lines[s_idx + new_cnt:]
            target_file.write_text("\n".join(restored) + "\n", encoding="utf-8")
            rev["status"] = "rejected"
            rev["reviewed_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
            meta_file = root / rev.get("patch_file", "").replace(".patch", ".json")
            if meta_file.exists():
                meta_file.write_text(json.dumps(rev, indent=2), encoding="utf-8")
            return True
        except Exception:
            pass

    return False


def accept_review_record(root: Path, rev: Dict[str, Any]) -> bool:
    rev["status"] = "accepted"
    rev["reviewed_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
    meta_file = root / rev.get("patch_file", "").replace(".patch", ".json")
    if meta_file.exists():
        meta_file.write_text(json.dumps(rev, indent=2), encoding="utf-8")
    return True


def handle_review_command(args: argparse.Namespace, root: Path) -> int:
    unreviewed = get_review_records(root, status_filter="unreviewed")

    if getattr(args, "accept_id", None):
        target_id = args.accept_id
        for r in unreviewed:
            if r["id"] == target_id or r["id"].endswith(target_id):
                accept_review_record(root, r)
                print(f"{BOLD}{GREEN}✓ Marked {r['id']} ({r['target_file']}) as ACCEPTED by human.{RESET}")
                return 0
        print(f"{RED}Error: Review ID '{target_id}' not found among unreviewed records.{RESET}")
        return 1

    if getattr(args, "reject_id", None):
        target_id = args.reject_id
        for r in unreviewed:
            if r["id"] == target_id or r["id"].endswith(target_id):
                if revert_review_record(root, r):
                    print(f"{BOLD}{YELLOW}✓ Successfully REVERTED changes for {r['id']} on {r['target_file']}.{RESET}")
                    return 0
                else:
                    print(f"{RED}Error: Failed to revert patch for {r['id']}.{RESET}")
                    return 1
        print(f"{RED}Error: Review ID '{target_id}' not found among unreviewed records.{RESET}")
        return 1

    if not unreviewed:
        print(f"\n{BOLD}{GREEN}✓ All implementations have been reviewed by a human! (0 pending){RESET}\n")
        return 0

    print(f"\n{BOLD}{CYAN}=== Implementations Awaiting Human Review ({len(unreviewed)} pending) ==={RESET}")
    print(f"{'#':<4} {'ID':<24} {'LOCATION':<32} {'TASK / DESCRIPTION'}")
    print("─" * 90)
    for idx, r in enumerate(unreviewed):
        loc = f"{r['target_file']}:{r['start_line']}"
        desc = r.get('description', '')[:35]
        print(f"[{idx+1:<2}] {YELLOW}{r['id']:<24}{RESET} {loc:<32} {desc}")
    print("─" * 90)

    if args.list or not sys.stdin.isatty():
        return 0

    try:
        choice = input(f"\n{BOLD}Select review # to inspect [1-{len(unreviewed)}], or [q]uit: {RESET}").strip().lower()
        if choice in ("q", "quit", ""):
            return 0
        idx = int(choice) - 1
        if not (0 <= idx < len(unreviewed)):
            print(f"{YELLOW}Invalid choice.{RESET}")
            return 0
    except Exception:
        return 0

    rev = unreviewed[idx]
    patch_path = root / rev.get("patch_file", "")
    if patch_path.exists():
        print(f"\n{BOLD}{CYAN}┌── Patch Diff for {rev['id']} ({rev['target_file']}:{rev['start_line']}) ──┐{RESET}")
        for l in patch_path.read_text(encoding="utf-8", errors="ignore").splitlines():
            if l.startswith("+") and not l.startswith("+++"):
                print(f"{GREEN}{l}{RESET}")
            elif l.startswith("-") and not l.startswith("---"):
                print(f"{RED}{l}{RESET}")
            elif l.startswith("@"):
                print(f"{CYAN}{l}{RESET}")
            else:
                print(f"{DIM}{l}{RESET}")
        print(f"{BOLD}{CYAN}└──────────────────────────────────────────────────────────────┘{RESET}\n")

    action = input(f"{BOLD}Action for {rev['id']}? [a]ccept (approved) / [r]eject (revert changes) / [i]nteractive nvim / [s]kip: {RESET}").strip().lower()
    if action == "a" or action == "accept":
        accept_review_record(root, rev)
        print(f"{BOLD}{GREEN}✓ Implementation {rev['id']} accepted and approved by human.{RESET}")
    elif action == "r" or action == "reject":
        if revert_review_record(root, rev):
            print(f"{BOLD}{YELLOW}✓ Implementation {rev['id']} rejected: cleanly reverted changes on {rev['target_file']}!{RESET}")
        else:
            print(f"{RED}Error: Reversion failed.{RESET}")
    elif action == "i" or action == "interactive":
        sock = get_active_nvim_socket()
        if sock and os.path.exists(sock):
            cmd = ["nvim", "--server", sock, "--remote-send", "<Cmd>GitReview<CR>"]
            subprocess.run(cmd)
            print(f"{BOLD}{BLUE}Opened review in active Neovim session.{RESET}")
        else:
            subprocess.call(["nvim", f"+{rev['start_line']}", "+GitReview", str(root / rev['target_file'])])
    return 0


def apply_changes(file_path: Path, orig_lines: List[str], start_line: int, old_count: int, new_lines: List[str], root: Path, task_id: str = "task", description: str = "") -> Dict[str, Any]:
    s_idx = max(0, start_line - 1)
    e_idx = min(len(orig_lines), s_idx + old_count)
    result_lines = orig_lines[:s_idx] + new_lines + orig_lines[e_idx:]
    file_path.write_text("\n".join(result_lines) + "\n", encoding="utf-8")
    meta = create_review_record(root, file_path, orig_lines, start_line, old_count, new_lines, task_id, description, status="unreviewed")
    return meta


def launch_nvim_interactive(file_path: Path, start_line: int, new_content: str, old_count: int) -> int:
    sock = get_active_nvim_socket()
    abs_path = str(file_path.resolve())

    if sock and os.path.exists(sock):
        # Transmit to running Neovim instance
        print(f"{BOLD}{BLUE}--> Sending in-line diff to active Neovim session ({sock})...{RESET}")
        lua_code = f"""
        local bufnr = vim.fn.bufadd('{abs_path}')
        vim.fn.bufload(bufnr)
        local cur_win = vim.api.nvim_get_current_win()
        vim.api.nvim_win_set_buf(cur_win, bufnr)
        pcall(vim.api.nvim_win_set_cursor, cur_win, {{{start_line}, 0}})
        require('agent').show_inline_diff(bufnr, {start_line}, [==[{new_content}]==], {old_count}, false)
        """
        escaped_lua = lua_code.replace('"', '\\"')
        cmd = ["nvim", "--server", sock, "--remote-expr", f'luaeval("{escaped_lua}")']
        subprocess.run(cmd, capture_output=True)
        return 0
    else:
        # Start new nvim session with diff
        print(f"{BOLD}{BLUE}--> Opening Neovim at {file_path}:{start_line}...{RESET}")
        lua_init = f"require('agent').show_inline_diff(vim.api.nvim_get_current_buf(), {start_line}, [==[{new_content}]==], {old_count}, false)"
        cmd = ["nvim", f"+{start_line}", f"+lua {lua_init}", str(file_path)]
        return subprocess.call(cmd)


def main():
    parser = argparse.ArgumentParser(
        description="agent: Source-First Task Execution Engine (CLI & Neovim)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  agent src/eval.py              # Execute in-line TODO in src/eval.py
  agent src/eval.py:42           # Target TODO specifically at line 42
  agent task.txt                 # Implement task described in task.txt
  agent --list                   # Scan and list all in-line tasks in repo
  agent --apply src/eval.py      # Non-interactively apply implementation
  agent -i src/eval.py           # Review implementation in Neovim in-line diff
        """
    )
    parser.add_argument("target", nargs="?", default=".", help="Target file (file.py[:line]) or directory (default: current directory)")
    parser.add_argument("--line", "-l", type=int, default=None, help="Specific target line number in file")
    parser.add_argument("--apply", "-a", action="store_true", help="Automatically apply changes to file without prompting")
    parser.add_argument("--diff", "-d", action="store_true", help="Print unified diff only and exit")
    parser.add_argument("--interactive", "-i", action="store_true", help="Open in Neovim with interactive in-line diff preview")
    parser.add_argument("--engine", choices=["opencode", "agy", "auto"], default="opencode", help="Execution engine (default: opencode)")
    parser.add_argument("--model", "-m", type=str, default=None, help="LLM model override")
    parser.add_argument("--list", action="store_true", help="List all detected TODO tasks without executing")
    parser.add_argument("--budget", type=int, default=16000, help="Dependency context token budget for Code Graph IR")
    parser.add_argument("--dry-run", action="store_true", help="Print prompt and context without calling LLM")
    parser.add_argument("--accept", dest="accept_id", type=str, default=None, help="Mark review ID as human-accepted")
    parser.add_argument("--reject", dest="reject_id", type=str, default=None, help="Revert review ID patch immediately")

    args = parser.parse_args()

    root = find_git_root()
    if args.accept_id or args.reject_id or args.target in ("review", "reviews", "git-review", "gitreview"):
        return handle_review_command(args, root)

    raw_target = args.target
    target_line = args.line

    # Handle file:line syntax
    if ":" in raw_target and not os.path.isdir(raw_target):
        parts = raw_target.rsplit(":", 1)
        if parts[1].isdigit():
            raw_target = parts[0]
            target_line = int(parts[1])

    target_path = Path(raw_target).resolve()

    if args.list:
        scan_dir = target_path if target_path.is_dir() else target_path.parent
        tasks = scan_project_tasks(scan_dir)
        print(f"\n{BOLD}{CYAN}=== In-Line Source Tasks ({len(tasks)} found in {scan_dir.name}) ==={RESET}")
        print(f"{'TIER':<6} {'ID':<24} {'LOCATION':<30} {'DESCRIPTION'}")
        print("─" * 90)
        for t in tasks:
            rel = Path(t['file']).name
            loc = f"{rel}:{t['line']}"
            desc = t['description']
            if len(desc) > 40:
                desc = desc[:37] + "..."
            tier_color = RED if t['tier'] == 'A' else (YELLOW if t['tier'] == 'B' else (BLUE if t['tier'] == 'C' else DIM))
            print(f"{tier_color}{t['tier']:<6}{RESET} {t['id']:<24} {loc:<30} {desc}")
        print()
        return 0

    if target_path.is_dir():
        # Scan directory tasks and prompt selection
        tasks = scan_project_tasks(target_path)
        if not tasks:
            print(f"{YELLOW}No in-line TODO or FIXME tasks found in {target_path}{RESET}")
            return 0

        print(f"\n{BOLD}{CYAN}Select an in-line task to implement:{RESET}")
        for idx, t in enumerate(tasks[:15]):
            rel = Path(t['file']).name
            tier_color = RED if t['tier'] == 'A' else (YELLOW if t['tier'] == 'B' else BLUE)
            print(f"  [{idx+1}] {tier_color}[Tier {t['tier']}]{RESET} {t['id']} ({rel}:{t['line']}) — {t['description'][:50]}")

        try:
            choice = input(f"\n{BOLD}Enter task number [1-{min(15, len(tasks))}]: {RESET}").strip()
            sel_idx = int(choice) - 1
            if 0 <= sel_idx < min(15, len(tasks)):
                selected_task = tasks[sel_idx]
                return execute_task(selected_task, Path(selected_task["file"]), args)
        except Exception:
            print(f"{YELLOW}Invalid selection. Exiting.{RESET}")
            return 0
        return 0

    if not target_path.exists():
        sys.stderr.write(f"{RED}Error: Target path does not exist: {target_path}{RESET}\n")
        return 1

    # Target is a file
    # Check if target is a plain task file (e.g. .txt, .md, or file with no TODO comments)
    is_code_file = target_path.suffix in COMMENT_PREFIXES
    tasks = extract_tasks_from_file(target_path) if is_code_file else []

    if tasks:
        # Find matching task
        if target_line:
            # Pick task closest to target_line
            best_task = min(tasks, key=lambda t: abs(t["line"] - target_line))
        else:
            best_task = tasks[0]
        return execute_task(best_task, target_path, args)
    else:
        # File is a standalone task description file (e.g. prompt.txt, task.md)
        # Directly execute the task written in the file!
        content = target_path.read_text(encoding="utf-8", errors="ignore").strip()
        if not content:
            sys.stderr.write(f"{RED}Error: Task file {target_path.name} is empty.{RESET}\n")
            return 1

        print(f"\n{BOLD}{CYAN}● [Agent]{RESET} Executing task from file {BOLD}{target_path.name}{RESET}...")
        task = {
            "file": str(target_path),
            "line": 1,
            "lines_count": len(content.splitlines()),
            "kind": "TASK",
            "id": target_path.stem,
            "tier": "A",
            "description": content,
            "raw_header": content.splitlines()[0],
        }
        return execute_task(task, target_path, args)


if __name__ == "__main__":
    sys.exit(main())
