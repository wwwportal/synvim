#!/usr/bin/env bash
# ==============================================================================
# specs / tasks: Source-First Specification & Task DAG CLI
# Mirrors Neovim's :Specs command directly in the terminal.
#
# Commands:
#   specs [list] [dir]        List in-tree specifications ordered by Tier A/B/C
#   specs informal [dir]      List informal TODO/FIXME tasks needing formal Lean 4 specification
#   specs draft [dir]         List draft specifications with open proof obligations
#   specs verified [dir]      List verified Lean 4 specification tasks
#   specs --json [dir]        Export specification DAG as machine-readable JSON
#   specs fix [--apply] [dir] Convert unstructured TODOs into verified contracts
#   specs verify [dir]        Verify LexLean specs via proof replay
#   specs add [file] <tag>:<desc>  Scaffold a structured contract
#   specs --help              Show this help message
# ==============================================================================

set -euo pipefail

# Locate lgcc compiler binary
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LGCC_BIN=""
if [ -x "$SCRIPT_DIR/lgcc" ]; then
    LGCC_BIN="$SCRIPT_DIR/lgcc"
elif command -v lgcc &>/dev/null; then
    LGCC_BIN="$(command -v lgcc)"
elif [ -x "$HOME/code/synvim/bin/lgcc" ]; then
    LGCC_BIN="$HOME/code/synvim/bin/lgcc"
elif [ -x "$HOME/code/syn-nvim/bin/lgcc" ]; then
    LGCC_BIN="$HOME/code/syn-nvim/bin/lgcc"
elif [ -x "$HOME/code/syntra-nvim/bin/lgcc" ]; then
    LGCC_BIN="$HOME/code/syntra-nvim/bin/lgcc"
elif [ -x "$HOME/.local/bin/lgcc" ]; then
    LGCC_BIN="$HOME/.local/bin/lgcc"
elif [ -x "$HOME/.config/nvim/bin/lgcc" ]; then
    LGCC_BIN="$HOME/.config/nvim/bin/lgcc"
fi

if [ -z "$LGCC_BIN" ]; then
    echo "tasks: Error: native lgcc binary not found in PATH or standard locations." >&2
    echo "       Please run ./setup.sh in synvim to install lgcc." >&2
    exit 1
fi

show_help() {
    cat <<EOF
specs / tasks: Source-First Specification & Task DAG CLI (Dual Neovim / Terminal)

Usage:
  specs [COMMAND] [OPTIONS]

Commands:
  specs, specs list [dir]        Scan in-tree task DAG and display tiered report (Tier A/B/C)
  specs graph [--reverse] [--all] [dir] Render interactive/ASCII Code & Spec DAG
  specs informal [dir]           List informal TODO/FIXME tasks needing formal Lean 4 specification
  specs draft [dir]              List draft specifications with open proof obligations
  specs verified [dir]           List verified Lean 4 specification tasks
  specs --json [dir]             Export in-tree task DAG as formatted JSON
  specs fix [--apply] [dir]      Synthesize structured task contracts from unstructured comments
  specs verify [dir]             Execute formal LexLean proof replay via native Rust engine
  specs add [file] <tag>:<desc>  Add a task contract (tag: TODO, FIXME, SPEC)
  specs help, --help, -h         Display this help guide

Examples:
  specs                          # View all in-tree specs in current repository
  specs informal                 # Show tasks needing formalization in Lean 4
  specs fix                      # Dry-run contract synthesis for lazy comments
  specs fix --apply              # Automatically rewrite lazy comments into verified contracts
  specs verify                   # Verify all machine-checked Lean 4 theorems
EOF
}

CMD="${1:-list}"

case "$CMD" in
    -h|--help|help)
        show_help
        exit 0
        ;;
    list)
        shift || true
        TARGET_DIR="${1:-.}"
        exec "$LGCC_BIN" --lint-tasks "$TARGET_DIR"
        ;;
    graph|--graph|dag|--dag|tree|--tree)
        shift || true
        exec "$LGCC_BIN" --graph "$@"
        ;;
    informal|--informal|unformalized|--unformalized)
        shift || true
        TARGET_DIR="${1:-.}"
        exec "$LGCC_BIN" --lint-tasks --informal "$TARGET_DIR"
        ;;
    draft|--draft)
        shift || true
        TARGET_DIR="${1:-.}"
        exec "$LGCC_BIN" --lint-tasks --draft "$TARGET_DIR"
        ;;
    verified|--verified)
        shift || true
        TARGET_DIR="${1:-.}"
        exec "$LGCC_BIN" --lint-tasks --verified "$TARGET_DIR"
        ;;
    --json|-j|json)
        shift || true
        TARGET_DIR="${1:-.}"
        exec "$LGCC_BIN" --lint-tasks --json "$TARGET_DIR"
        ;;
    fix|--fix|fix-tasks|--fix-tasks)
        shift || true
        exec "$LGCC_BIN" --fix-tasks "$@"
        ;;
    verify|--verify|verify-specs|--verify-specs)
        shift || true
        TARGET_DIR="${1:-.}"
        exec "$LGCC_BIN" --verify-specs "$TARGET_DIR"
        ;;
    tw|taskwarrior)
        echo "specs: Notice: Taskwarrior has been phased out in favor of in-tree source specifications." >&2
        echo "       Use 'specs' or 'specs informal' to inspect in-tree specification contracts." >&2
        exit 0
        ;;
    add)
        shift || true
        if [ $# -lt 1 ]; then
            echo "tasks add: missing task specification." >&2
            echo "Usage: tasks add [file] <TODO|FIXME|SPEC>:<description>" >&2
            exit 1
        fi
        TARGET_FILE=""
        SPEC_STR=""
        if [ $# -ge 2 ] && [ -f "$1" ]; then
            TARGET_FILE="$1"
            shift
            SPEC_STR="$*"
        else
            SPEC_STR="$*"
        fi

        # Parse KIND:DESC
        KIND="TODO"
        DESC="$SPEC_STR"
        if [[ "$SPEC_STR" =~ ^(TODO|FIXME|SPEC):(.*)$ ]]; then
            KIND="${BASH_REMATCH[1]}"
            DESC="$(echo "${BASH_REMATCH[2]}" | sed 's/^[ \t]*//')"
        fi

        if [ -z "$TARGET_FILE" ]; then
            # Default to first modified or first candidate source file
            TARGET_FILE="$(git ls-files '*.rs' '*.lua' 2>/dev/null | head -n 1 || true)"
        fi

        if [ -z "$TARGET_FILE" ] || [ ! -f "$TARGET_FILE" ]; then
            echo "tasks add: Target file not found: $TARGET_FILE" >&2
            exit 1
        fi

        # Generate slug
        SLUG="$(echo "$DESC" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//' | cut -d'-' -f1-3)"
        [ -z "$SLUG" ] && SLUG="task"
        STEM="$(basename "$TARGET_FILE" | cut -d. -f1 | tr '_' '-')"
        TASK_ID="${STEM}-${SLUG}"

        # Choose comment prefix based on extension
        EXT="${TARGET_FILE##*.}"
        PREFIX="//"
        if [ "$EXT" = "lua" ]; then
            PREFIX="--"
        elif [ "$EXT" = "py" ] || [ "$EXT" = "sh" ] || [ "$EXT" = "bash" ]; then
            PREFIX="#"
        fi

        TEMP_FILE="$(mktemp)"
        DEF_NAME="$(echo "$TASK_ID" | tr '-' '_')"
        cat <<EOF > "$TEMP_FILE"
$PREFIX $KIND($TASK_ID | tier:B): $DESC
$PREFIX Description: $DESC
$PREFIX Criterion: review: "$DESC is implemented and verified"
EOF
        if [ "$KIND" = "SPEC" ]; then
            cat <<EOF >> "$TEMP_FILE"
$PREFIX [lean:spec]
$PREFIX def $DEF_NAME : Bool := true
$PREFIX theorem ${DEF_NAME}_verified : $DEF_NAME = true := by rfl
EOF
        fi
        cat "$TARGET_FILE" >> "$TEMP_FILE"
        mv "$TEMP_FILE" "$TARGET_FILE"
        echo "● Scaffolded $KIND contract '$TASK_ID' into $TARGET_FILE"
        ;;
    *)
        # Default to lint-tasks if argument is a directory or path
        exec "$LGCC_BIN" --lint-tasks "$@"
        ;;
esac
